msgid "Entity Overview"
msgstr "Indholdsoverblik"

msgid "Overviews"
msgstr "Overblikke"

msgid "Overview functionality for entities."
msgstr "Overbliksfunktionalitet til entities."

msgid "Overview filter"
msgstr "Overbliksfilter"

msgid "Overview configuration"
msgstr "Overblikskonfiguration"

msgid "A short name to help you identify this overview in the overview list."
msgstr "Et kort navn til at hjælpe med at identificere dette overblik i overblikslisten."

msgid "Field with filter and display options for entities."
msgstr "Felt med filter og visningsindstillinger til entiteter."

msgid "The available types of entities."
msgstr "De tilgængelige typer af entiteter."

msgid "Facets"
msgstr "Facetter"

msgid "Overview form"
msgstr "Overbliksformular"

msgid "List date"
msgstr "Liste dato"

msgid "Alphabetical"
msgstr "Alfabetisk"

msgid "Display of total number of items"
msgstr "Visning af total antal elementer"

msgid "Total display: @show_total"
msgstr "Total visning: @show_total"

msgid "Filtered out of total number of items"
msgstr "Filtrede ud af total antal elements"

msgid "Shown items out of filtered number of items"
msgstr "Vist elementer ud af filtrerede antal elementer"

msgid "Showing @count out of @total"
msgstr "Viser @count ud af @total"

msgid "Show entities of this type."
msgstr "Vis elementer af denne type."

msgid "Allow exposing facets"
msgstr "Tillad valg af facetter"

msgid "Display pager at the bottom."
msgstr "Vis pager i bunden."

msgid "Select the facets that you want to expose to the user."
msgstr "Vælg hvilke facetter du gerne vil give brugere adgang til."

msgid "How many entities to show at once."
msgstr "Hvor mange elementer skal vises på en gang."

msgid "Page size select"
msgstr "Side størrelses valg"

msgid "What criteria to sort entities by."
msgstr "Hvilket kriterie skal elementer sorteres efter."

msgid "View mode used to display search results."
msgstr "View mode brugt til at vise søge resultater."

msgid "What fields can be used as facets?"
msgstr "Hvilke felter kan bruges som facetter?"

msgid "Sort select"
msgstr "Sorterings valg"

msgid "Add overview"
msgstr "Tilføj overblik"

msgid "Configure Entity Overview"
msgstr "Konfigurer indholdsoverblikke"

msgid "Configure entity overview."
msgstr "Konfigurer indholdsoverblikke."

msgid "There are no overviews yet."
msgstr "Der er ingen overblikke endnu."

msgid "What fields can be used as facets?"
msgstr "Hvilke felter kan bruges som facetter?"

msgid "What field should be used for sorting?"
msgstr "Hvilket felt skal bruges til sortering?"

msgid "Are you sure you want to delete the overview config %label?"
msgstr "Er du sikker på at du vil slette overblikskonfigurationen %label?"

msgid "Overview config %label has been deleted."
msgstr "Overblikskonfigurationen %label er blevet slettet."

msgid "You must select at least one entity bundle."
msgstr "Du skal vælge mindst en entitets type."

msgid "The %engine engine only supports a single entity type."
msgstr "%engine motoren understøtter kun en enkelt entitetstype."

msgid "Overview %label saved."
msgstr "Overblik %label gemt."

msgid "Enable deeplinking"
msgstr "Aktivér deeplinks"

msgid "Overviews will change the url when filters are changed allowing users to bookmark specific filter settings. Will cost performance."
msgstr "Overblikke vil ændre url'en når der bliver ændret filtre hvilket gør det muligt at bogmærke specifikke filter indstillinger. Dette koster dog ydeevne."
